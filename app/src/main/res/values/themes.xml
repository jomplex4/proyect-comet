<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Comet" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/red</item>
        <item name="colorControlActivated">@color/red</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:fontFamily">@font/space_grotesk_regular</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="alertDialogTheme">@style/Theme.Comet.Dialog</item>
    </style>

    <!-- Blank system splash: the branded splash (icon + POWERED BY) is drawn by the app itself. -->
    <style name="Theme.Comet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Comet</item>
    </style>

    <style name="Theme.Comet.Player" parent="Theme.Comet">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Bottom sheet (Playing Queue): floats at the bottom, dims what is behind. -->
    <style name="Theme.Comet.Sheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:fontFamily">@font/space_grotesk_regular</item>
    </style>

    <style name="Theme.Comet.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/red_hot</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">@font/space_grotesk_regular</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Comet.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Comet.DialogButton</item>
    </style>

    <style name="Theme.Comet.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/red_hot</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/circle_ripple</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PlayerChip">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PlayerButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/circle_ripple</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PanelTitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
    </style>
</resources>
