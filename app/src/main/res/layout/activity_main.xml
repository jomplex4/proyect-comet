<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/logo_dm" />

            <ImageButton
                android:id="@+id/btnSearch"
                style="@style/IconButton"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSearchBack"
                style="@style/IconButton"
                android:contentDescription="Close search"
                android:src="@drawable/ic_back" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Search videos"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <LinearLayout
                android:id="@+id/messageBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/messageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/messageAction"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_on"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <include
            android:id="@+id/mini"
            layout="@layout/view_mini_player" />

        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/graphite_1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelClose"
                style="@style/IconButton"
                android:contentDescription="Cancel"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/selCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk_medium"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnSelAll"
                style="@style/IconButton"
                android:contentDescription="Select all"
                android:src="@drawable/ic_select_all" />

            <ImageButton
                android:id="@+id/btnSelDelete"
                style="@style/IconButton"
                android:layout_marginStart="6dp"
                android:contentDescription="Delete"
                android:src="@drawable/ic_trash"
                app:tint="@color/red_hot" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/graphite_2" />

        <LinearLayout
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal">

            <include android:id="@+id/navVideos" layout="@layout/view_nav_item" />
            <include android:id="@+id/navMusic" layout="@layout/view_nav_item" />
            <include android:id="@+id/navPhotos" layout="@layout/view_nav_item" />
        </LinearLayout>
    </LinearLayout>

    <!-- Branded splash: COMET icon in the middle, POWERED BY + DIGITALMINDS at the bottom. -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/splashIcon"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/splash_icon" />

        <LinearLayout
            android:id="@+id/splashBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="56dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_medium"
                android:letterSpacing="0.32"
                android:text="POWERED BY"
                android:textColor="@color/muted"
                android:textSize="10.5sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/logo_dm" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
