<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/headerMain"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/bg_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/headerPlay"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip_on"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_medium"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/headerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/headerAction"
        style="@style/IconButton"
        android:contentDescription="Action"
        android:src="@drawable/ic_sort" />
</LinearLayout>
