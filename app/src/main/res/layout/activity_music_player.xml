<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Blurred cover behind everything, darkened so text always reads well. -->
    <ImageView
        android:id="@+id/bgArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grad_player" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/IconButton"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnAddPlaylist"
                style="@style/IconButton"
                android:contentDescription="Add to playlist"
                android:src="@drawable/ic_playlist_add" />

            <ImageButton
                android:id="@+id/btnShare"
                style="@style/IconButton"
                android:contentDescription="Share"
                android:src="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/btnDelete"
                style="@style/IconButton"
                android:contentDescription="Delete"
                android:src="@drawable/ic_trash" />

            <ImageButton
                android:id="@+id/btnProperties"
                style="@style/IconButton"
                android:contentDescription="Properties"
                android:src="@drawable/ic_info" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="40dp"
            android:paddingTop="12dp"
            android:paddingEnd="40dp"
            android:paddingBottom="12dp">

            <com.digitalminds.comet.ui.SquareFrame
                android:id="@+id/artFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_art_circle">

                <ImageView
                    android:id="@+id/artIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_note" />

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.digitalminds.comet.ui.SquareFrame>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnTimer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_ripple"
                    android:contentDescription="Sleep timer"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_timer" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/timerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:textColor="@color/red_hot"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_ripple"
                android:contentDescription="Favorite"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/timePos"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_medium"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12.5sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:progressDrawable="@drawable/seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_medium"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnRepeat"
                style="@style/PlayerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Repeat mode"
                android:src="@drawable/ic_mode_order" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/PlayerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Previous"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_chip_on"
                android:contentDescription="Play or pause"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/PlayerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Next"
                android:src="@drawable/ic_next" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnQueue"
                style="@style/PlayerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Queue"
                android:src="@drawable/ic_queue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRewind"
                style="@style/PlayerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Back 10 seconds"
                android:src="@drawable/ic_replay10" />

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_pill_dark"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="1X"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnForward"
                style="@style/PlayerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Forward 10 seconds"
                android:src="@drawable/ic_forward10" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/speedPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_hud"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/speedRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="0dp" />
    </HorizontalScrollView>
</FrameLayout>
