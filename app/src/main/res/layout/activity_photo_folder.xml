<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk_medium"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnSort"
            style="@style/IconButton"
            android:contentDescription="Sort"
            android:src="@drawable/ic_sort" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_grotesk_medium"
        android:letterSpacing="0.08"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/muted"
        android:textSize="12.5sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Nothing here"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/mini"
        layout="@layout/view_mini_player" />

    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/graphite_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSelClose"
            style="@style/IconButton"
            android:contentDescription="Cancel"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/selCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_medium"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSelAll"
            style="@style/IconButton"
            android:contentDescription="Select all"
            android:src="@drawable/ic_select_all" />

        <ImageButton
            android:id="@+id/btnSelShare"
            style="@style/IconButton"
            android:contentDescription="Share"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/btnSelInfo"
            style="@style/IconButton"
            android:contentDescription="Properties"
            android:src="@drawable/ic_info" />

        <ImageButton
            android:id="@+id/btnSelDelete"
            style="@style/IconButton"
            android:layout_marginStart="6dp"
            android:contentDescription="Delete"
            android:src="@drawable/ic_trash"
            app:tint="@color/red_hot" />
    </LinearLayout>
</LinearLayout>
